    "fixtures": "node e2e/fixtures/generate.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@letra-grande/ai": "workspace:*",
    "@letra-grande/design": "workspace:*",
    "@letra-grande/privacy": "workspace:*",
    "@letra-grande/schema": "workspace:*",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
